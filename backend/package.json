{
  "name": "task-management",
  "version": "1.0.0",
  "description": "Task management API with Express, Sequelize, PostgreSQL and Redis",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "db:create": "ts-node src/scripts/create-database.ts",
    "db:init": "ts-node src/scripts/init-db.ts",
    "db:seed-test": "ts-node src/scripts/seed-test-data.ts"
  },
  "keywords": ["task-management", "express", "sequelize", "postgresql", "redis"],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.7",
    "typescript": "^5.6.3"
  }
}
